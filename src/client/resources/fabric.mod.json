{
	"schemaVersion": 1,
	"id": "betterlogviewer",
	"version": "${version}",
	"name": "BetterLogViewer",
	"description": "BetterLogViewer makes viewing CoreProtect results more convenient. As you scroll through the pages, the content updates in place, preserving the original text, colors, tooltips, and clickable elements.",
	"authors": [
		"DarkCray_"
	],
	"license": "MIT",
	"icon": "assets/betterlogviewer/icon.png",
	"contact": {
		"homepage": "https://github.com/DarkCray0/BetterLogViewer",
		"sources": "https://github.com/DarkCray0/BetterLogViewer",
		"issues": "https://github.com/DarkCray0/BetterLogViewer/issues"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.modrinth": "https://modrinth.com/mod/betterlogviewer"
			},
			"update_checker": false
		}
	},
	"environment": "client",
	"entrypoints": {
		"client": [
			"me.darkcray_.betterlogviewer.BetterLogViewerClient"
		]
	},
	"mixins": [
		{
			"config": "betterlogviewer.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
